{
  "name": "keelwerk-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "The keelwerk framework workspace.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "tsc -b",
    "keelwerk": "node --conditions=@keelwerk/source packages/cli/src/bin/keelwerk.ts",
    "sketch": "tsc -p packages/core/tsconfig.sketch.json",
    "manifests": "node scripts/generate-manifests.ts",
    "fixtures:migrations": "node scripts/generate-fixture-migrations.ts",
    "surfaces": "node scripts/generate-surfaces.ts",
    "budgets": "node scripts/type-budgets/run-budgets.ts",
    "bench:types": "pnpm --filter @keelwerk/type-budgets bench",
    "check": "biome ci . && knip && tsc -b && vitest run",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "knip": "knip",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@keelwerk/biome-config": "workspace:*",
    "@types/node": "26.6.5",
    "knip": "6.42.1",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
