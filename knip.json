{
  "$schema": "https://unpkg.com/knip@6.42.1/schema.json",
  "ignore": ["docs/**"],
  "workspaces": {
    ".": {},
    "packages/*": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/biome-config": {},
    "spikes/composition-types": {
      "entry": ["src/**/*.test-d.ts", "sketch/acceptance.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "sketch/**/*.ts"],
      "ignore": ["sketch/**"]
    }
  }
}
