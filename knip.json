{
  "$schema": "https://unpkg.com/knip@6.42.1/schema.json",
  "ignore": ["docs/**", "packages/biome-config/plugins/fixtures/**"],
  "workspaces": {
    "packages/*": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/biome-config": {
      "ignoreDependencies": ["@biomejs/biome"]
    },
    "spikes/composition-types": {
      "entry": ["src/**/*.test-d.ts", "sketch/acceptance.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "sketch/**/*.ts"],
      "ignore": ["sketch/**"]
    },
    "examples/portal/apps/portal": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@keelwerk/cli", "@keelwerk/data"]
    },
    "packages/type-budgets": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@keelwerk/module-accounts", "@keelwerk/module-auth", "tsc"]
    },
    "packages/adapter-postgres": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/module-auth": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/testing": {
      "entry": ["src/**/*.test-d.ts", "src/fixtures/modules/*/migrations/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/cli": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["tsc"]
    },
    "packages/module-accounts": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/transport-http": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/transport-rest": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/client": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/data": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/core": {
      "entry": ["src/**/*.test-d.ts", "sketch/acceptance.ts"],
      "project": ["src/**/*.ts"]
    },
    "spikes/node26-rechecks": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"]
    },
    "spikes/prepare-variant": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"]
    },
    "spikes/interpreter-overhead": {
      "project": ["src/**/*.ts"]
    },
    "examples/portal": {
      "entry": [".launchway/deployment.ts", ".launchway/launchway.ts"],
      "ignoreDependencies": ["@keelwerk/cli"]
    }
  }
}
