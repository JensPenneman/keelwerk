{
  "$schema": "https://unpkg.com/knip@6.42.1/schema.json",
  "ignore": ["docs/**", "packages/biome-config/plugins/fixtures/**"],
  "workspaces": {
    "packages/*": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/biome-config": {
      "ignoreDependencies": ["@biomejs/biome"]
    },
    "spikes/composition-types": {
      "entry": ["src/**/*.test-d.ts", "sketch/acceptance.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "sketch/**/*.ts"],
      "ignore": ["sketch/**"]
    },
    "examples/portal/apps/portal": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@keelwerk/cli",
        "@keelwerk/data",
        "@keelwerk/events",
        "@keelwerk/live",
        "@keelwerk/module-api-keys",
        "@keelwerk/module-audit",
        "@keelwerk/module-members",
        "@keelwerk/transport-graphql",
        "@keelwerk/transport-orpc",
        "@keelwerk/transport-trpc",
        "@orpc/client",
        "@trpc/client",
        "eventsource"
      ]
    },
    "packages/type-budgets": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@keelwerk/module-accounts", "@keelwerk/module-auth", "tsc"]
    },
    "packages/adapter-postgres": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/module-auth": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/testing": {
      "entry": ["src/**/*.test-d.ts", "src/fixtures/modules/*/migrations/**/*.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@keelwerk/live", "@keelwerk/transport-http"]
    },
    "packages/cli": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@keelwerk/live", "tsc"]
    },
    "packages/module-accounts": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/transport-http": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@keelwerk/live", "@types/ws", "ws"]
    },
    "packages/transport-rest": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@keelwerk/live"]
    },
    "packages/client": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@keelwerk/live"]
    },
    "packages/data": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/core": {
      "entry": ["src/**/*.test-d.ts", "sketch/acceptance.ts"],
      "project": ["src/**/*.ts"]
    },
    "spikes/node26-rechecks": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"]
    },
    "spikes/prepare-variant": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"]
    },
    "spikes/interpreter-overhead": {
      "project": ["src/**/*.ts"]
    },
    "examples/portal": {
      "entry": [".launchway/deployment.ts", ".launchway/launchway.ts"],
      "ignoreDependencies": ["@keelwerk/cli", "@keelwerk/events"]
    },
    "packages/events": {
      "entry": ["src/**/*.test-d.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/live": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@keelwerk/transport-http"]
    },
    "packages/transport-graphql": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@keelwerk/live", "graphql-ws"]
    },
    "packages/transport-trpc": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@keelwerk/core",
        "@keelwerk/live",
        "@keelwerk/testing",
        "@keelwerk/transport-http",
        "@trpc/client",
        "@trpc/server",
        "@types/ws",
        "eventsource",
        "superjson"
      ]
    },
    "packages/transport-orpc": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@keelwerk/core",
        "@keelwerk/live",
        "@keelwerk/testing",
        "@keelwerk/transport-http",
        "@keelwerk/transport-rest",
        "@orpc/client",
        "@orpc/openapi",
        "@orpc/server"
      ]
    },
    "packages/module-api-keys": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": [
        "@keelwerk/adapter-postgres",
        "@keelwerk/core",
        "@keelwerk/module-accounts",
        "@keelwerk/testing"
      ]
    },
    "packages/module-members": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": [
        "@keelwerk/adapter-postgres",
        "@keelwerk/core",
        "@keelwerk/module-accounts",
        "@keelwerk/module-auth",
        "@keelwerk/testing"
      ]
    },
    "packages/module-audit": {
      "entry": ["src/**/*.test-d.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": [
        "@keelwerk/adapter-postgres",
        "@keelwerk/core",
        "@keelwerk/events",
        "@keelwerk/module-accounts",
        "@keelwerk/module-auth",
        "@keelwerk/module-members",
        "@keelwerk/testing"
      ]
    }
  }
}
