{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "extends": ["@keelwerk/biome-config/biome"],
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/generated",
      "!**/pnpm-lock.yaml",
      "!docs",
      "!packages/biome-config/plugins/fixtures"
    ]
  },
  "plugins": [
    {
      "path": "./node_modules/@keelwerk/biome-config/plugins/named-module-types.grit",
      "includes": [
        "**/src/base.ts",
        "**/src/app.ts",
        "**/*.test.ts",
        "**/*.test-d.ts",
        "**/spikes/**"
      ]
    },
    {
      "path": "./node_modules/@keelwerk/biome-config/plugins/no-import-effects.grit",
      "includes": [
        "**/src/**",
        "!**/*.config.ts",
        "!**/*.generated.ts",
        "!**/*.test.ts",
        "!**/*.test-d.ts",
        "!**/spikes/write-path/src/main.ts",
        "!**/*.bench.ts"
      ]
    }
  ]
}
