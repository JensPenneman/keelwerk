{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "extends": ["@keelwerk/biome-config/biome"],
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/generated",
      "!**/pnpm-lock.yaml",
      "!CHANGELOG.md",
      "!docs",
      "!packages/biome-config/plugins/fixtures"
    ]
  },
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@testcontainers/postgresql",
                      "@testcontainers/postgresql/**",
                      "testcontainers",
                      "testcontainers/**"
                    ],
                    "message": "Start a PostgreSQL test container with startPostgres of @keelwerk/testing/postgres: its stop applies the deadlock rule."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/testing/src/postgres/**"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      "includes": ["packages/*/migrations/*/0*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["spikes/**"],
      "linter": {
        "enabled": false
      }
    }
  ]
}
