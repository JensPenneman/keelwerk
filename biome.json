{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "extends": ["@keelwerk/biome-config/biome"],
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/generated",
      "!**/pnpm-lock.yaml",
      "!docs",
      "!packages/biome-config/plugins/fixtures"
    ]
  },
  "overrides": [
    {
      "includes": ["packages/*/migrations/*/0*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["spikes/**"],
      "linter": {
        "enabled": false
      }
    }
  ]
}
