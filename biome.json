{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "extends": ["@keelwerk/biome-config/biome"],
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/generated",
      "!**/pnpm-lock.yaml",
      "!CHANGELOG.md",
      "!docs",
      "!packages/biome-config/plugins/fixtures"
    ]
  },
  "plugins": [
    {
      "path": "./scripts/lint/pg-connections.grit",
      "includes": [
        "**/src/**",
        "!**/packages/adapter-postgres/src/connections/**",
        "!**/*.test.ts",
        "!**/*.test-d.ts"
      ]
    },
    {
      "path": "./scripts/lint/testcontainers.grit",
      "includes": ["**", "!packages/testing/src/postgres/**"]
    }
  ],
  "overrides": [
    {
      "includes": ["packages/*/migrations/*/0*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["spikes/**"],
      "linter": {
        "enabled": false
      }
    }
  ]
}
