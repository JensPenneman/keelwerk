{
  "name": "@keelwerk/type-budgets",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "exports": {
    ".": {
      "@keelwerk/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "bench": "node --conditions=@keelwerk/source src/compose-app.bench.ts --shouldFormat false --benchPercentThreshold 15 --benchErrorOnThresholdExceeded"
  },
  "dependencies": {
    "@keelwerk/core": "workspace:*",
    "@keelwerk/module-accounts": "workspace:*",
    "@keelwerk/module-auth": "workspace:*"
  },
  "devDependencies": {
    "@ark/attest": "0.57.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
