      "@keelwerk/transport-http": ["./test/sketch-stand-ins/transport-http.ts"],
      "@keelwerk/transport-rest": ["./test/sketch-stand-ins/rest.ts"],
      "@keelwerk/transport-graphql": ["./test/sketch-stand-ins/graphql.ts"],
      "@keelwerk/live": ["./test/sketch-stand-ins/live.ts"],
      "@keelwerk/client": ["./test/sketch-stand-ins/client.ts"]
