{
  "components": {
    "headers": {
      "etag": {
        "description": "The entity tag of the row; send it back as `If-Match` or `If-None-Match`.",
        "schema": {
          "type": "string"
        }
      },
      "idempotentReplayed": {
        "description": "`true` when the response replays an earlier command with the same key.",
        "schema": {
          "type": "string"
        }
      },
      "keelwerkCommandId": {
        "description": "The command id (the idempotency key, or one generated).",
        "schema": {
          "type": "string"
        }
      },
      "keelwerkEffects": {
        "description": "The ids of the external effects the command requested, comma separated.",
        "schema": {
          "type": "string"
        }
      },
      "keelwerkVersion": {
        "description": "The API version that answered.",
        "schema": {
          "type": "string"
        }
      },
      "link": {
        "description": "RFC 8288 links to the neighbouring pages.",
        "schema": {
          "type": "string"
        }
      },
      "location": {
        "description": "Where the created row or the command receipt can be fetched.",
        "schema": {
          "type": "string"
        }
      },
      "preferenceApplied": {
        "description": "The `Prefer` preferences that were honoured.",
        "schema": {
          "type": "string"
        }
      },
      "requestId": {
        "description": "The request id, also `requestId` of an error body.",
        "schema": {
          "type": "string"
        }
      },
      "retryAfter": {
        "description": "Seconds to wait before retrying.",
        "schema": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "parameters": {
      "idempotencyKey": {
        "description": "The command id: a repeated key replays the first answer.",
        "in": "header",
        "name": "Idempotency-Key",
        "schema": {
          "type": "string"
        }
      },
      "ifMatch": {
        "description": "The `ETag` of the version the change applies to; a mismatch answers 412.",
        "in": "header",
        "name": "If-Match",
        "schema": {
          "type": "string"
        }
      },
      "ifNoneMatch": {
        "description": "An `ETag` the client holds; a match answers 304.",
        "in": "header",
        "name": "If-None-Match",
        "schema": {
          "type": "string"
        }
      },
      "prefer": {
        "description": "`respond-async` to get the 202 receipt, optionally with `wait=<seconds>` (at most 60).",
        "in": "header",
        "name": "Prefer",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "problem400": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Malformed request",
        "headers": {
          "Keelwerk-Version": {
            "$ref": "#/components/headers/keelwerkVersion"
          },
          "x-request-id": {
            "$ref": "#/components/headers/requestId"
          }
        }
      },
      "problem401": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Unauthenticated",
        "headers": {
          "Keelwerk-Version": {
            "$ref": "#/components/headers/keelwerkVersion"
          },
          "x-request-id": {
            "$ref": "#/components/headers/requestId"
          }
        }
      },
      "problem403": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Forbidden",
        "headers": {
          "Keelwerk-Version": {
            "$ref": "#/components/headers/keelwerkVersion"
          },
          "x-request-id": {
            "$ref": "#/components/headers/requestId"
          }
        }
      },
      "problem404": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Not found",
        "headers": {
          "Keelwerk-Version": {
            "$ref": "#/components/headers/keelwerkVersion"
          },
          "x-request-id": {
            "$ref": "#/components/headers/requestId"
          }
        }
      },
      "problem412": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Precondition failed",
        "headers": {
          "Keelwerk-Version": {
            "$ref": "#/components/headers/keelwerkVersion"
          },
          "x-request-id": {
            "$ref": "#/components/headers/requestId"
          }
        }
      },
      "problem413": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Payload too large",
        "headers": {
          "Keelwerk-Version": {
            "$ref": "#/components/headers/keelwerkVersion"
          },
          "x-request-id": {
            "$ref": "#/components/headers/requestId"
          }
        }
      },
      "problem422": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Validation failed or unsupported",
        "headers": {
          "Keelwerk-Version": {
            "$ref": "#/components/headers/keelwerkVersion"
          },
          "x-request-id": {
            "$ref": "#/components/headers/requestId"
          }
        }
      },
      "problem429": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Rate limited",
        "headers": {
          "Keelwerk-Version": {
            "$ref": "#/components/headers/keelwerkVersion"
          },
          "Retry-After": {
            "$ref": "#/components/headers/retryAfter"
          },
          "x-request-id": {
            "$ref": "#/components/headers/requestId"
          }
        }
      },
      "problem500": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Internal error",
        "headers": {
          "Keelwerk-Version": {
            "$ref": "#/components/headers/keelwerkVersion"
          },
          "x-request-id": {
            "$ref": "#/components/headers/requestId"
          }
        }
      },
      "problem503": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Unavailable",
        "headers": {
          "Keelwerk-Version": {
            "$ref": "#/components/headers/keelwerkVersion"
          },
          "Retry-After": {
            "$ref": "#/components/headers/retryAfter"
          },
          "x-request-id": {
            "$ref": "#/components/headers/requestId"
          }
        }
      }
    },
    "schemas": {
      "CommandReceipt": {
        "additionalProperties": false,
        "properties": {
          "commandId": {
            "type": "string"
          },
          "status": {
            "const": "accepted"
          }
        },
        "required": [
          "commandId",
          "status"
        ],
        "type": "object"
      },
      "CoreBackend": {
        "additionalProperties": false,
        "properties": {
          "$masked": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "apiVersion": {
            "type": "string"
          },
          "app": {
            "type": "string"
          },
          "archivedAt": {
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "config": {
            "type": "object"
          },
          "createdAt": {
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "id": {
            "pattern": "^bknd_[0-7][0-9a-hjkmnp-tv-z]{25}$",
            "readOnly": true,
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "placement": {
            "type": "string"
          },
          "status": {
            "default": "active",
            "enum": [
              "active",
              "suspended"
            ],
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "version": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "readOnly": true,
            "type": "integer"
          }
        },
        "required": [
          "app",
          "createdAt",
          "id",
          "name",
          "placement",
          "status",
          "updatedAt",
          "version"
