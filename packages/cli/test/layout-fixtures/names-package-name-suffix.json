{
  "title": "a package name that only ends in the module name",
  "set": {
    "packages/module-shop/package.json": "{\n  \"name\": \"@acme/notmodule-shop\",\n  \"version\": \"0.0.0\",\n  \"type\": \"module\",\n  \"exports\": {\n    \".\": {\n      \"@keelwerk/source\": \"./src/module.generated.ts\",\n      \"types\": \"./dist/src/module.generated.d.ts\",\n      \"default\": \"./dist/src/module.generated.js\"\n    }\n  },\n  \"publishConfig\": {\n    \"exports\": {\n      \".\": {\n        \"types\": \"./dist/src/module.generated.d.ts\",\n        \"default\": \"./dist/src/module.generated.js\"\n      }\n    }\n  },\n  \"dependencies\": {\n    \"@keelwerk/core\": \"workspace:*\",\n    \"@acme/module-accounts\": \"workspace:*\"\n  }\n}\n"
  },
  "remove": [],
  "regenerate": true,
  "expect": [
    {
      "kind": "names",
      "path": "packages/module-shop/package.json",
      "message": "the package is named @acme/notmodule-shop, the module id is shop"
    }
  ]
}
