        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@keelwerk/client": "workspace:*",
    "@keelwerk/core": "workspace:*",
    "@keelwerk/data": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "@stricli/core": "1.3.0",
    "pino": "10.4.0",
    "typescript-6": "npm:typescript@6.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@keelwerk/live": "workspace:*",
    "@keelwerk/testing": "workspace:*",
    "@keelwerk/transport-http": "workspace:*",
    "vitest": "5.0.5"
  }
}
