{
  "name": "@keelwerk/cli",
  "version": "0.0.0",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JensPenneman/keelwerk.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "exports": {
    ".": {
      "@keelwerk/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
